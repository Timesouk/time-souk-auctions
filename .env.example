# Copy to .env.local for local work. On Vercel, add these under Project → Settings → Environment Variables.
# Never commit real values.

# Your live address, no trailing slash (used in emails, WhatsApp and payment return links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase → Project Settings → API (the publishable/anon key and the secret/service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string. Vercel sends it to the every-minute job.
CRON_SECRET=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM="The Time Souk <auctions@example.com>"
# Where staff alerts go (new consignments, payments). Comma-separated.
STAFF_EMAIL=

# Twilio: Verify for phone codes, WhatsApp for invoices
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Channels offered for phone codes: whatsapp, sms or both
TWILIO_VERIFY_CHANNELS=whatsapp,sms
# Your approved WhatsApp sender, e.g. whatsapp:+9715XXXXXXXX
TWILIO_WHATSAPP_FROM=
# Content template SIDs (HX...) approved by WhatsApp. See docs/SETUP.md for the wording.
TWILIO_WA_TEMPLATE_INVOICE=
TWILIO_WA_TEMPLATE_REMINDER=

# Ziina (card payments)
ZIINA_API_KEY=
ZIINA_WEBHOOK_SECRET=
# true = test payments (no money moves). Set to false when you go live.
ZIINA_TEST_MODE=true

# Tabby
TABBY_SECRET_KEY=
TABBY_MERCHANT_CODE=
TABBY_WEBHOOK_SECRET=

# Tamara
TAMARA_API_URL=https://api-sandbox.tamara.co
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=

# Optional: preview mode with lot 4 live on the block (only when Supabase is not set)
DEMO_LIVE=
